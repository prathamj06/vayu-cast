# ==============================================================================
# SERVER-SIDE ONLY SECRETS (GitHub Actions Secrets / Local Backend)
# DO NOT ADD NEXT_PUBLIC_ PREFIX TO THESE KEYS!
# ==============================================================================

# Google Gemini AI Studio API Key (For pre-generating zone advisories)
GEMINI_API_KEY="your_gemini_api_key_here"

# World Air Quality Index Token (For fetching CPCB telemetry)
WAQI_API_TOKEN="your_waqi_api_token_here"

# OpenAQ API Key (Optional secondary telemetry)
OPENAQ_API_KEY="your_openaq_api_key_here"

# Open Government Data (data.gov.in) API Key (Tier-1 CPCB Real-time Telemetry)
DATAGOV_API_KEY="your_datagov_api_key_here"

# Google Earth Engine Project ID (For satellite spatial joins)
GEE_PROJECT_ID="your_gee_project_id_here"

# ==============================================================================
# CLIENT-SAFE / FRONTEND CONFIGURATION
# ==============================================================================

# MapTiler Key (Optional: Leave blank to use free, keyless CARTO Dark Matter tiles)
NEXT_PUBLIC_MAPTILER_KEY=""
